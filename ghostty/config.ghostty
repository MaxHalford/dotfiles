# Hold Command while hovering a URL, then left-click to open it.
# Ghostty 1.3.1 does not detect plain file paths.
link-url = true

# Option+Backspace deletes the previous word.
# Escape + DEL is understood by Zsh as backward-kill-word.
keybind = alt+backspace=text:\x1b\x7f

# Open the fzf-powered Zsh history search with Option+R.
keybind = alt+r=text:\x12

# Let Herdr handle Cmd+G for shipr.
keybind = super+g=unbind

# Let Herdr handle Cmd+D for the review popup.
keybind = super+d=unbind

# Let Herdr handle Cmd+E for VS Code.
keybind = super+e=unbind

# Follow macOS appearance with Ghostty's bundled Rosé Pine themes.
theme = light:Rose Pine Dawn,dark:Rose Pine Moon

# Rosé Pine Dawn's bright black is light gray, and Claude's ANSI theme draws
# diffs in it with the faint attribute, which made them unreadable. Darken
# any text that is too close to its background (WCAG ratio, 1 = off).
minimum-contrast = 3
faint-opacity = 0.7

window-padding-x = 8
window-padding-y = 6
adjust-cell-height = 15%

font-family = "RecMonoLinear Nerd Font Mono"
font-size = 13.5
