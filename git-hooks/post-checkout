#!/bin/sh

# Git runs post-checkout with a null previous ref when `git worktree add`
# (or a clone) checks out for the first time. For new linked worktrees, copy
# every gitignored .env file from the primary worktree, keeping its path.
case "$1" in
    *[!0]*) ;;
    *)
        primary="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
        here="$(git rev-parse --show-toplevel)"
        if [ -n "$primary" ] && [ "$primary" != "$here" ]; then
            # --directory collapses ignored folders such as node_modules, so
            # this stays fast and skips .env files inside dependencies.
            git -C "$primary" ls-files --others --ignored --exclude-standard --directory |
            while IFS= read -r path; do
                case "${path##*/}" in .env|.env.*) ;; *) continue ;; esac
                # Never overwrite a file the worktree already has.
                [ -f "$primary/$path" ] && [ ! -e "$here/$path" ] || continue
                mkdir -p "$(dirname "$here/$path")"
                cp -p "$primary/$path" "$here/$path"
                printf 'Copied %s from primary worktree\n' "$path"
            done
        fi
        ;;
esac

export HOOK_NAME=post-checkout
exec "$(dirname "$0")/forward-local" "$@"
