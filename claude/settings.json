{
  "cleanupPeriodDays": 3,
  "statusLine": {
    "type": "command",
    "command": "'/opt/homebrew/bin/node' '/Users/max/.claude/plugins/claude-hud/statusline.mjs'"
  },
  "enabledPlugins": {
    "beads@beads-marketplace": true,
    "pyright-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "qthun-plugin@qthun": true,
    "qthun@qthun": true,
    "frontend-design@claude-plugins-official": true,
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "qthun": {
      "source": {
        "source": "github",
        "repo": "MaxHalford/qthun"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/agents/hooks/gauth.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/max/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoScrollEnabled": false,
  "allowedTools": [
    "Task",
    "Bash(git log:*)",
    "Bash(awk:*)",
    "Bash(sed:*)",
    "Glob",
    "Grep",
    "LS",
    "Read",
    "Edit",
    "MultiEdit",
    "Write",
    "WebFetch",
    "WebSearch"
  ]
}
